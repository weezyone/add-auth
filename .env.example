# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/add_auth
DB_HOST=localhost
DB_PORT=5432
DB_NAME=add_auth
DB_USER=postgres
DB_PASSWORD=password
# Leave DB_SSL unset or empty. Do not set DB_SSL=false — Zod z.coerce.boolean()
# treats the string "false" as true and will enable SSL.

# Server Configuration
PORT=3000
NODE_ENV=development

# Comma-separated CORS allowlist (src/index.ts). Include every browser origin.
# FRONTEND_URL=http://localhost:3000,http://localhost:5173,http://localhost:3001

# Security Configuration (JWT_SECRET and SESSION_SECRET must be >= 32 characters)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=your-super-secret-session-key-at-least-32-characters-long
SESSION_TIMEOUT=86400000

# Password Security
BCRYPT_ROUNDS=12

# Logging
LOG_LEVEL=info

# Rate Limiting (config object; many Express limiters still use hardcoded windows)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (CSRF tokens, rate limits, sessions, password-reset tokens)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Password-reset mailer (src/utils/emailService.ts). Unconfigured if USER/PASS empty.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_USER=
EMAIL_PASS=

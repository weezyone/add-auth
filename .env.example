# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/add_auth
DB_HOST=localhost
DB_PORT=5432
DB_NAME=add_auth
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false

# Server Configuration
PORT=3000
NODE_ENV=development
# Express 'trust proxy'. Leave unset if clients connect directly. Behind a
# reverse proxy / load balancer set the hop count (e.g. 1) so rate limiting
# keys on the real client IP. Never 'true' on an internet-facing app.
# TRUST_PROXY=1

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=your-super-secret-session-key-at-least-32-characters-long
SESSION_TIMEOUT=86400000

# Password Security
BCRYPT_ROUNDS=12

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis Configuration (if using Redis for sessions/cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email verification
# Password logins are refused until the user clicks the link in the
# verification email. Links point at FRONTEND_URL/verify-email?token=...;
# the frontend POSTs the token to /api/auth/verify-email.
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_HOURS=24

# Outbound email (SMTP via nodemailer). If EMAIL_USER/EMAIL_PASS are unset,
# emails are written to the log instead (dev) or dropped with a warning
# (production) - verification emails will not reach users.
EMAIL_FROM=noreply@yourdomain.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password